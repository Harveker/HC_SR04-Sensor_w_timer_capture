# .gitignore for ARM GCC STM32 projects

# Build output
/build/
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.lst
*.srec
*.axf
*.dep
*.su
*.i
*.log

# Temporary and backup files
*.tmp
*.bak
*.swp
*.swo
*.swn
*.swd
*.orig
*.rej

# Compiled libraries
*.out
*.a
*.lib
*.exe

# IDE files
# Note: .vscode/ is currently tracked with sanitized settings
# This pattern prevents future uncommitted files from being tracked
.vscode/
.idea/
*.launch
*.settings/
*.cproject
*.project
*.mxproject
*.uvopt*
*.uvproj*
*.mdk5
*.code-workspace

# CubeMX generated files
*.ioc

# Debug and programming tool files
*.gdb*
*.stlink*
*.stldr*
*.stmap*
*.stproj*

# Other development files
*.user
*.sublime*

# Python compiled files
*.pyc
*.pyo
*.class

# Security and credentials
.env
.env.local
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json
config.local.*

# OS specific
Thumbs.db
.DS_Store
desktop.ini
